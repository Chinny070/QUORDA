# Local-only credentials for running tests/integration against Studio Next
# via gltest. Never commit the real .env - it's gitignored.
#
# These should be throwaway accounts funded with a small amount of test
# GEN (a few GEN each is enough to run the full integration suite), not
# accounts holding anything of value.
GLTEST_BUYER_PRIVATE_KEY=0x...
GLTEST_SELLER_A_PRIVATE_KEY=0x...
GLTEST_SELLER_B_PRIVATE_KEY=0x...
GLTEST_SELLER_C_PRIVATE_KEY=0x...
GLTEST_ATTACKER_PRIVATE_KEY=0x...
GLTEST_RUNNER_PRIVATE_KEY=0x...
